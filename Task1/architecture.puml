@startuml architecture
!include <C4/C4_Container>

' DWH — корпоративное хранилище данных; ИИ — искусственный интеллект.
' SQL — язык запросов к данным; API — программный интерфейс взаимодействия.
' S3 — интерфейс доступа к объектному хранилищу; JSON — формат обмена данными.
' HTTPS — защищённый протокол взаимодействия; REST — стиль программных интерфейсов.

title Будущее 2.0 — целевая архитектура через год\nДиаграмма контейнеров C4

LAYOUT_TOP_DOWN()
skinparam defaultFontName Arial
skinparam wrapWidth 220
skinparam maxMessageSize 180
skinparam nodesep 45
skinparam ranksep 65
skinparam LegendFontColor #222222
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #AAAAAA

Person(operator, "Сотрудник клиники", "Ведёт приём и работает с медицинской картой")
Person(employee, "Бизнес-пользователь", "Сотрудник головного офиса или направления")
System_Ext(partners, "Новые бизнесы", "Фармацевтические компании и производитель медицинской электроники")

System_Boundary(clinic, "Клиники — локальный контур") {
    Container(desktop, "Интерфейс клиники", "PowerBuilder", "Рабочее место оператора")
    ContainerDb(legacy, "Медицинская часть прежнего DWH", "Microsoft SQL Server 2008", "Карты, истории болезней, исследования, посещения и счета. Сохраняет логику клиники")
    Container(adapter, "Адаптер медицинской системы", "Apache Camel", "Отдельные интерфейсы для медицинских данных и выгрузки счетов и посещений")
}

System_Boundary(ai, "ИИ — отдельная облачная среда") {
    Container(ai_service, "Сервис медицинского ИИ", "Python", "Анализирует исследования. Логика ИИ вынесена из DWH")
    ContainerDb(ai_data, "Данные ИИ", "S3-совместимое хранилище", "Модели и результаты анализа исследований")
}

System_Boundary(finance, "Финтех — отдельная облачная среда") {
    Container(finance_service, "Финтех-сервисы", "Golang, Java", "Обслуживают счета и кредиты. Финансовая логика вынесена из DWH")
    ContainerDb(finance_data, "Данные финтеха", "PostgreSQL", "Клиенты банка, счета, кредиты и операции")
}

System_Boundary(office, "Головной офис — отдельная облачная среда") {
    Container(office_service, "Внутренние сервисы", "Существующие приложения компании", "Ведут учёт персонала, имущества и расходов")
    ContainerDb(office_data, "Данные головного офиса", "PostgreSQL", "Персонал, инвентаризация и внутренний финансовый учёт")
}

System_Boundary(platform, "Облачная платформа данных") {
    Container(ingestion, "Загрузка и подготовка данных", "Apache Airflow", "Отдельные задания направлений. Проверяет состав данных и заранее рассчитывает показатели")
    ContainerDb(lakehouse, "Аналитические данные", "S3-совместимое хранилище, Apache Iceberg", "Отдельные области направлений. Подготовленные наборы и агрегаты для отчётов")
    Container(tables, "Каталог таблиц", "Nessie", "Схемы и версии таблиц Iceberg")
    Container(query, "Запросы к витринам", "Dremio", "Читает подготовленные данные. Вычислительные ресурсы масштабируются отдельно от хранения")
    Container(catalog, "Каталог данных", "DataHub", "Описания наборов, владельцы и определения показателей. Доступ к описаниям по ролям")
    Container(portal, "Портал отчётности", "Power BI", "Готовые и собственные отчёты. Права на наборы и фильтры доступа к строкам")
}

Rel_R(operator, desktop, "Работает с картой и приёмом")
Rel_D(desktop, legacy, "Читает и изменяет данные клиники", "SQL")
Rel_L(adapter, legacy, "Читает данные и сохраняет результаты ИИ", "SQL")
Rel_R(adapter, ai_service, "Передаёт исследование; получает результат анализа", "HTTPS")
Rel_D(ai_service, ai_data, "Читает модели, сохраняет результаты", "S3 API")
Rel_D(finance_service, finance_data, "Читает и изменяет финансовые данные", "SQL")
Rel_D(office_service, office_data, "Читает и изменяет учётные данные", "SQL")

Rel_U(ingestion, adapter, "Получает счета и посещения без клинических данных", "HTTPS / JSON")
Rel_U(ingestion, ai_service, "Получает число запросов, длительность и статусы обработки", "HTTPS / JSON")
Rel_U(ingestion, finance_service, "Получает данные для финансовой отчётности", "HTTPS / JSON")
Rel_U(ingestion, office_service, "Получает данные учёта для отчётов", "HTTPS / JSON")
Rel_U(ingestion, partners, "Получает согласованные наборы по общему контракту", "HTTPS / JSON")

Rel_D(ingestion, query, "Обновляет таблицы и рассчитывает витрины", "SQL")
Rel_R(query, tables, "Получает и обновляет метаданные таблиц", "REST")
Rel_L(query, lakehouse, "Читает и записывает аналитические данные", "S3 API / Iceberg")
Rel_U(catalog, query, "Получает схемы и метаданные витрин", "HTTPS")
Rel_U(portal, query, "Загружает подготовленные витрины", "SQL")
Rel_U(employee, portal, "Открывает и создаёт отчёты в пределах своих прав", "HTTPS")
Rel_U(employee, catalog, "Находит наборы и читает их описания", "HTTPS")

Lay_R(ai_service, finance_service)
Lay_R(finance_service, office_service)
Lay_R(office_service, partners)
Lay_D(ai_data, ingestion)
Lay_D(finance_data, ingestion)
Lay_D(office_data, ingestion)
Lay_R(portal, catalog)

legend bottom
  <b>Быстрая отчётность:</b> показатели рассчитываются при загрузке; отчёты читают готовые витрины и не нагружают медицинскую систему.
  <b>Независимое развитие:</b> команды отвечают за свои сервисы, данные и задания подготовки; новая бизнес-логика остаётся в сервисах.
  <b>Новые бизнесы:</b> публикуют наборы по общему контракту; менять медицинский DWH не нужно.

  Медицинские карты, истории болезней и результаты исследований не загружаются в аналитическую платформу.
  Области данных и задания разделены по направлениям. Доступ выдан по ролям; соединения зашифрованы.
  Критичные облачные сервисы имеют резервные экземпляры на другой площадке. Для хранилищ настроены резервные копии и восстановление.
endlegend
@enduml
